NODE_ENV=development
API_PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/optronix

JWT_ACCESS_SECRET=change-this-to-a-64-char-random-access-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-64-char-random-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

ENFORCE_MANAGER_REOPEN_PIN=false
DEFAULT_GEOFENCE_RADIUS_METERS=100

APP_WEB_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Optronix Operations"
